# ---------------------------------------------------------------------------
# ShardScope .gitignore
# This file MUST stay tracked.
# ---------------------------------------------------------------------------

# Keep Markdown working documents local
*.md
*.markdown
*.mdx

# Keep planning and design documents local
planning/
.planning/
plans/
docs/planning/
docs/plans/
*_PRD.*
*.prd
*.plan

# Local commit workflow (regenerated by tools/bootstrap_commit_skill.py)
.agents/

# Local authorization for automated commits (never shared)
.shardscope-commit-auth.json

# Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Profiler and benchmark artifacts (large, machine-specific, regenerable)
# reports/ stays local until reviewed: a rendered report embeds provenance,
# file paths and operation names from the machine that produced it
runs/
reports/
artifacts/
*.pt.trace.json
*.pt.trace.json.gz
*.trace.json
*.trace.json.gz
tensorboard/
data/

# OS / editor noise
.DS_Store
.idea/
.vscode/
